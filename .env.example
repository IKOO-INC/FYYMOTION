# Salin file ini menjadi .env untuk lokal, ATAU isi nilai yang sama
# di Vercel Dashboard -> Project -> Settings -> Environment Variables.
# JANGAN commit connection string asli ke Git.
SECRET_KEY=ganti-dengan-string-acak-panjang-anda
ADMIN_USERNAME=admin
ADMIN_PASSWORD=fyymotion123

# MongoDB Atlas (utama). Isi agar data permanen di Vercel.
# Atlas -> Database -> Connect -> Drivers -> salin connection string.
# Atlas -> Network Access -> tambahkan 0.0.0.0/0 untuk server Vercel.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/fyymotion?retryWrites=true&w=majority
MONGODB_DB_NAME=fyymotion

# DATABASE_PATH=/path/kustom/database.json  # hanya untuk fallback JSON lokal
PORT=5000
