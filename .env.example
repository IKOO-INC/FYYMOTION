# Salin file ini menjadi .env untuk lokal, ATAU isi nilai yang sama
# di Vercel Dashboard -> Project -> Settings -> Environment Variables.
# JANGAN commit connection string asli ke Git.
SECRET_KEY=ganti-dengan-string-acak-panjang-anda
ADMIN_USERNAME=admin
ADMIN_PASSWORD=fyymotion123

# MongoDB Atlas (utama). Isi agar data permanen di Vercel.
# Atlas -> Database -> Connect -> Drivers -> salin connection string.
# Atlas -> Network Access -> tambahkan 0.0.0.0/0 untuk server Vercel.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/fyymotion?retryWrites=true&w=majority
MONGODB_DB_NAME=fyymotion

# DATABASE_PATH=/path/kustom/database.json  # hanya untuk fallback JSON lokal
PORT=5000

# WhatsApp admin untuk landing /academy lama (CTA "Daftar Sekarang", pesan tetap J-ACADEMY)
WA_NUMBER=62812xxxxxxx

# ==========================================================================
# FYY MOTION Academy — platform belajar (/academy/*, /admin/academy/*)
# ==========================================================================
# Memakai MONGODB_URI yang SAMA di atas, tapi database TERPISAH supaya tidak
# bentrok dengan koleksi aplikasi utama. Nama database bisa diganti bila perlu.
ACADEMY_MONGODB_DB_NAME=fyymotion_academy

# SMTP untuk kirim kode OTP (registrasi/login/lupa password) via email.
# Jika KOSONG, sistem otomatis masuk "mode developer": kode OTP ditampilkan
# langsung di halaman verifikasi (DIBERI PERINGATAN JELAS) supaya alur tetap
# bisa dipakai sambil menunggu SMTP diisi. WAJIB diisi sebelum dipakai publik.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=akun-pengirim@gmail.com
SMTP_PASS=app-password-smtp-anda
SMTP_FROM=FYY MOTION Academy <akun-pengirim@gmail.com>

# Nomor WhatsApp admin untuk konfirmasi pembayaran Academy (format 62xxxxxxxxxx,
# tanpa + atau 0 di depan). Jika kosong, sistem otomatis memakai WA_NUMBER di atas.
WA_ADMIN_NUMBER=62812xxxxxxx

# URL gambar QRIS GoPay Merchant (upload ke Google Drive/ImgBB lalu pakai link
# gambar langsung). Jika kosong, halaman struk tetap bisa dipakai (tombol WA
# tetap jalan) tapi tanpa menampilkan gambar QRIS.
GOPAY_QRIS_IMAGE_URL=https://contoh.com/qris-fyymotion.png
